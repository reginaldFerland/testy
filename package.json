{
  "name": "testy",
  "displayName": "%displayName%",
  "description": "%description%",
  "repository": {
    "url": "https://github.com/reginaldFerland/testy",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/reginaldFerland/testy/issues"
  },
  "homepage": "https://github.com/reginaldFerland/testy#readme",
  "license": "MIT",
  "qna": "https://github.com/reginaldFerland/testy/issues",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "keywords": [
    "csharp",
    "dotnet",
    "test",
    "testing",
    "unit test",
    "code coverage",
    "microsoft.testing.platform",
    "test explorer",
    "xunit",
    "nunit",
    "mstest"
  ],
  "publisher": "reginaldFerland",
  "version": "1.2.0",
  "icon": "testy.png",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "workspaceContains:**/*.slnf"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "testy.refreshTests",
        "title": "%command.refreshTests%",
        "category": "Testy",
        "icon": "$(run-all)"
      },
      {
        "command": "testy.runAffected",
        "title": "%command.runAffected%",
        "category": "Testy",
        "icon": "$(play)"
      },
      {
        "command": "testy.toggleAutoRun",
        "title": "%command.toggleAutoRun%",
        "category": "Testy"
      },
      {
        "command": "testy.pause",
        "title": "%command.pause%",
        "category": "Testy",
        "icon": "$(debug-pause)"
      },
      {
        "command": "testy.resume",
        "title": "%command.resume%",
        "category": "Testy",
        "icon": "$(debug-start)"
      },
      {
        "command": "testy.cancelRun",
        "title": "%command.cancelRun%",
        "category": "Testy",
        "icon": "$(debug-stop)",
        "enablement": "testy.running"
      },
      {
        "command": "testy.clearCoverage",
        "title": "%command.clearCoverage%",
        "category": "Testy",
        "icon": "$(clear-all)"
      },
      {
        "command": "testy.exportCoverage",
        "title": "%command.exportCoverage%",
        "category": "Testy",
        "icon": "$(export)"
      },
      {
        "command": "testy.resetCaches",
        "title": "%command.resetCaches%",
        "category": "Testy",
        "icon": "$(trash)"
      },
      {
        "command": "testy.showOutput",
        "title": "%command.showOutput%",
        "category": "Testy",
        "icon": "$(output)"
      },
      {
        "command": "testy.showMenu",
        "title": "%command.showMenu%",
        "category": "Testy"
      },
      {
        "command": "testy.explainSelection",
        "title": "%command.explainSelection%",
        "category": "Testy",
        "icon": "$(question)"
      },
      {
        "command": "testy.excludeProject",
        "title": "%command.excludeProject%",
        "category": "Testy",
        "icon": "$(exclude)"
      },
      {
        "command": "testy.runFile",
        "title": "%command.runFile%",
        "category": "Testy",
        "icon": "$(play)"
      },
      {
        "command": "testy.runFolder",
        "title": "%command.runFolder%",
        "category": "Testy",
        "icon": "$(play)"
      },
      {
        "command": "testy.runCoveringTests",
        "title": "%command.runCoveringTests%",
        "category": "Testy"
      },
      {
        "command": "testy.showTest",
        "title": "%command.showTest%",
        "category": "Testy",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "testy.runAffected",
          "when": "view == workbench.view.testing && testy.active",
          "group": "navigation@1"
        },
        {
          "command": "testy.pause",
          "when": "view == workbench.view.testing && testy.active && !testy.paused",
          "group": "navigation@2"
        },
        {
          "command": "testy.resume",
          "when": "view == workbench.view.testing && testy.active && testy.paused",
          "group": "navigation@2"
        },
        {
          "command": "testy.refreshTests",
          "when": "view == workbench.view.testing && testy.active",
          "group": "testy@1"
        },
        {
          "command": "testy.clearCoverage",
          "when": "view == workbench.view.testing && testy.active",
          "group": "testy@2"
        },
        {
          "command": "testy.exportCoverage",
          "when": "view == workbench.view.testing && testy.active",
          "group": "testy@3"
        },
        {
          "command": "testy.resetCaches",
          "when": "view == workbench.view.testing && testy.active",
          "group": "testy@4"
        }
      ],
      "commandPalette": [
        {
          "command": "testy.refreshTests",
          "when": "testy.active"
        },
        {
          "command": "testy.runAffected",
          "when": "testy.active"
        },
        {
          "command": "testy.toggleAutoRun",
          "when": "testy.active"
        },
        {
          "command": "testy.pause",
          "when": "testy.active && !testy.paused"
        },
        {
          "command": "testy.resume",
          "when": "testy.active && testy.paused"
        },
        {
          "command": "testy.cancelRun",
          "when": "testy.active && testy.running"
        },
        {
          "command": "testy.clearCoverage",
          "when": "testy.active"
        },
        {
          "command": "testy.exportCoverage",
          "when": "testy.active"
        },
        {
          "command": "testy.resetCaches",
          "when": "testy.active"
        },
        {
          "command": "testy.showOutput",
          "when": "testy.active"
        },
        {
          "command": "testy.showMenu",
          "when": "testy.active"
        },
        {
          "command": "testy.explainSelection",
          "when": "false"
        },
        {
          "command": "testy.excludeProject",
          "when": "false"
        },
        {
          "command": "testy.runFile",
          "when": "testy.active && resourceScheme == file && resourceExtname == .cs"
        },
        {
          "command": "testy.runFolder",
          "when": "false"
        },
        {
          "command": "testy.runCoveringTests",
          "when": "testy.active && editorLangId == csharp"
        },
        {
          "command": "testy.showTest",
          "when": "false"
        }
      ],
      "testing/item/context": [
        {
          "command": "testy.explainSelection",
          "when": "controllerId == testy && testy.active",
          "group": "testy@1"
        },
        {
          "command": "testy.excludeProject",
          "when": "controllerId == testy && testy.active && testId =~ /^project:/",
          "group": "testy@2"
        }
      ],
      "testing/message/context": [
        {
          "command": "testy.showOutput",
          "when": "testMessage == testy.failure && testy.active",
          "group": "testy@1"
        }
      ],
      "editor/context": [
        {
          "command": "testy.runCoveringTests",
          "when": "testy.active && resourceScheme == file && resourceExtname == .cs",
          "group": "testy@2"
        },
        {
          "command": "testy.runFile",
          "when": "testy.active && resourceScheme == file && resourceExtname == .cs",
          "group": "testy@1"
        }
      ],
      "explorer/context": [
        {
          "command": "testy.runFile",
          "when": "testy.active && resourceScheme == file && resourceExtname == .cs",
          "group": "testy@1"
        },
        {
          "command": "testy.runFolder",
          "when": "testy.active && resourceScheme == file && (explorerResourceIsFolder || resourceExtname == .csproj)",
          "group": "testy@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "testy.runAffected",
        "key": "ctrl+; t",
        "mac": "cmd+; t",
        "when": "testy.active"
      },
      {
        "command": "testy.runCoveringTests",
        "key": "ctrl+; ctrl+t",
        "mac": "cmd+; cmd+t",
        "when": "testy.active && editorTextFocus && editorLangId == csharp"
      },
      {
        "command": "testy.toggleAutoRun",
        "key": "ctrl+; p",
        "mac": "cmd+; p",
        "when": "testy.active"
      },
      {
        "command": "testy.cancelRun",
        "key": "ctrl+; x",
        "mac": "cmd+; x",
        "when": "testy.active && testy.running"
      }
    ],
    "viewsWelcome": [
      {
        "view": "workbench.view.testing",
        "contents": "%viewsWelcome.noTestProjects%",
        "when": "testy.noTestProjects"
      }
    ],
    "configuration": {
      "title": "Testy",
      "properties": {
        "testy.autoRun": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.autoRun%",
          "scope": "window",
          "order": 0
        },
        "testy.runMode": {
          "type": "string",
          "default": "affected",
          "enum": [
            "affected",
            "all"
          ],
          "enumDescriptions": [
            "%config.runMode.affected%",
            "%config.runMode.all%"
          ],
          "markdownDescription": "%config.runMode%",
          "scope": "window",
          "order": 1
        },
        "testy.trigger": {
          "type": "string",
          "default": "save",
          "enum": [
            "save",
            "fileSystem"
          ],
          "enumDescriptions": [
            "%config.trigger.save%",
            "%config.trigger.fileSystem%"
          ],
          "markdownDescription": "%config.trigger%",
          "scope": "window",
          "order": 2
        },
        "testy.debounceTime": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "maximum": 60000,
          "markdownDescription": "%config.debounceTime%",
          "scope": "window",
          "order": 3,
          "tags": [
            "advanced"
          ]
        },
        "testy.runWithCoverage": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.runWithCoverage%",
          "scope": "window",
          "order": 4
        },
        "testy.showCoverage": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.showCoverage%",
          "scope": "window",
          "order": 5
        },
        "testy.inlineResults": {
          "type": "string",
          "default": "gutterAndHover",
          "enum": [
            "off",
            "gutter",
            "gutterAndHover"
          ],
          "enumDescriptions": [
            "%config.inlineResults.off%",
            "%config.inlineResults.gutter%",
            "%config.inlineResults.gutterAndHover%"
          ],
          "markdownDescription": "%config.inlineResults%",
          "scope": "window",
          "order": 6
        },
        "testy.solution": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.solution%",
          "scope": "resource",
          "order": 7
        },
        "testy.projects.include": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "markdownDescription": "%config.projects.include%",
          "scope": "resource",
          "order": 8
        },
        "testy.projects.exclude": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "markdownDescription": "%config.projects.exclude%",
          "scope": "resource",
          "order": 9
        },
        "testy.fileWatcherPattern": {
          "type": "string",
          "default": "**/*.{cs,csproj,sln,slnx,slnf,props,targets,runsettings,json,config,resx,editorconfig,globalconfig,ruleset,razor,cshtml,xaml,axaml,proto}",
          "minLength": 1,
          "markdownDescription": "%config.fileWatcherPattern%",
          "scope": "window",
          "order": 10,
          "tags": [
            "advanced"
          ]
        },
        "testy.exclude": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "markdownDescription": "%config.exclude%",
          "scope": "resource",
          "order": 11
        },
        "testy.buildConfiguration": {
          "type": "string",
          "default": "Debug",
          "minLength": 1,
          "markdownDescription": "%config.buildConfiguration%",
          "scope": "window",
          "order": 12
        },
        "testy.maxParallelProjects": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.maxParallelProjects%",
          "scope": "window",
          "order": 13,
          "tags": [
            "advanced"
          ]
        },
        "testy.maxParallelTestFiles": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.maxParallelTestFiles%",
          "scope": "window",
          "order": 14,
          "tags": [
            "advanced"
          ]
        },
        "testy.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "minLength": 1,
          "markdownDescription": "%config.dotnetPath%",
          "scope": "machine-overridable",
          "order": 15
        },
        "testy.testArguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "%config.testArguments%",
          "scope": "window",
          "order": 16
        },
        "testy.timeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 10,
          "maximum": 86400,
          "markdownDescription": "%config.timeoutSeconds%",
          "scope": "window",
          "order": 17,
          "tags": [
            "advanced"
          ]
        },
        "testy.coverageToolPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.coverageToolPath%",
          "scope": "machine-overridable",
          "order": 18
        },
        "testy.additionalConfigurations": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "markdownDescription": "%config.additionalConfigurations%",
          "scope": "window",
          "order": 19
        },
        "testy.debugConfiguration": {
          "type": "object",
          "default": {},
          "properties": {
            "type": {
              "type": "string",
              "default": "coreclr",
              "markdownDescription": "%config.debugConfiguration.type%"
            },
            "justMyCode": {
              "type": "boolean",
              "default": true,
              "markdownDescription": "%config.debugConfiguration.justMyCode%"
            },
            "requireExactSource": {
              "type": "boolean",
              "default": true,
              "markdownDescription": "%config.debugConfiguration.requireExactSource%"
            },
            "enableStepFiltering": {
              "type": "boolean",
              "default": true,
              "markdownDescription": "%config.debugConfiguration.enableStepFiltering%"
            },
            "suppressJITOptimizations": {
              "type": "boolean",
              "default": false,
              "markdownDescription": "%config.debugConfiguration.suppressJITOptimizations%"
            },
            "sourceFileMap": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "markdownDescription": "%config.debugConfiguration.sourceFileMap%"
            },
            "symbolOptions": {
              "type": "object",
              "additionalProperties": true,
              "markdownDescription": "%config.debugConfiguration.symbolOptions%",
              "properties": {
                "searchPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "markdownDescription": "%config.debugConfiguration.symbolOptions.searchPaths%"
                },
                "searchMicrosoftSymbolServer": {
                  "type": "boolean",
                  "markdownDescription": "%config.debugConfiguration.symbolOptions.searchMicrosoftSymbolServer%"
                },
                "searchNuGetOrgSymbolServer": {
                  "type": "boolean",
                  "markdownDescription": "%config.debugConfiguration.symbolOptions.searchNuGetOrgSymbolServer%"
                },
                "cachePath": {
                  "type": "string",
                  "markdownDescription": "%config.debugConfiguration.symbolOptions.cachePath%"
                }
              }
            },
            "sourceLinkOptions": {
              "type": "object",
              "additionalProperties": true,
              "markdownDescription": "%config.debugConfiguration.sourceLinkOptions%"
            },
            "logging": {
              "type": "object",
              "additionalProperties": true,
              "markdownDescription": "%config.debugConfiguration.logging%"
            },
            "request": {
              "markdownDescription": "%config.debugConfiguration.request%"
            },
            "processId": {
              "markdownDescription": "%config.debugConfiguration.processId%"
            }
          },
          "additionalProperties": true,
          "markdownDescription": "%config.debugConfiguration%",
          "scope": "resource",
          "order": 20
        },
        "testy.problems.publishBuildDiagnostics": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%config.problems.publishBuildDiagnostics.auto%",
            "%config.problems.publishBuildDiagnostics.always%",
            "%config.problems.publishBuildDiagnostics.never%"
          ],
          "markdownDescription": "%config.problems.publishBuildDiagnostics%",
          "scope": "window",
          "order": 21
        }
      }
    },
    "walkthroughs": [
      {
        "id": "testy.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "prerequisites",
            "title": "%walkthrough.prerequisites.title%",
            "description": "%walkthrough.prerequisites.description%",
            "media": {
              "markdown": "media/walkthrough/prerequisites.md"
            },
            "completionEvents": []
          },
          {
            "id": "trust",
            "title": "%walkthrough.trust.title%",
            "description": "%walkthrough.trust.description%",
            "media": {
              "markdown": "media/walkthrough/trust.md"
            },
            "completionEvents": []
          },
          {
            "id": "baseline",
            "title": "%walkthrough.baseline.title%",
            "description": "%walkthrough.baseline.description%",
            "media": {
              "markdown": "media/walkthrough/baseline.md"
            },
            "completionEvents": [
              "onCommand:testy.showOutput"
            ]
          },
          {
            "id": "coverage",
            "title": "%walkthrough.coverage.title%",
            "description": "%walkthrough.coverage.description%",
            "media": {
              "markdown": "media/walkthrough/coverage.md"
            },
            "completionEvents": [
              "onSettingChanged:testy.showCoverage"
            ]
          },
          {
            "id": "pause",
            "title": "%walkthrough.pause.title%",
            "description": "%walkthrough.pause.description%",
            "media": {
              "markdown": "media/walkthrough/pause.md"
            },
            "completionEvents": [
              "onCommand:testy.showMenu"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run lint && npm run build:dotnet:release && npm run bundle -- --production",
    "compile": "tsc -p ./ && npm run bundle && npm run build:dotnet",
    "bundle": "node esbuild.mjs",
    "watch:bundle": "node esbuild.mjs --watch",
    "build:dotnet": "npm run build:analyzer && npm run build:process-host && npm run build:observer",
    "build:dotnet:release": "npm run build:analyzer -- -p:TESTY_RELEASE=true && npm run build:process-host -- -p:TESTY_RELEASE=true && npm run build:observer -- -p:TESTY_RELEASE=true",
    "build:observer": "node -e \"require('fs').rmSync('dist/observer', { recursive: true, force: true })\" && dotnet build backend/Testy.RuntimeObserver/Testy.RuntimeObserver.csproj --configuration Release --output dist/observer --nologo",
    "build:process-host": "node -e \"require('fs').rmSync('dist/processhost', { recursive: true, force: true })\" && dotnet build backend/Testy.ProcessHost/Testy.ProcessHost.csproj --configuration Release --output dist/processhost --nologo",
    "build:analyzer": "node -e \"require('fs').rmSync('dist/analyzer', { recursive: true, force: true })\" && dotnet build backend/Testy.Analysis/Testy.Analysis.csproj --configuration Release --output dist/analyzer --nologo",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint && npm run typecheck:tests",
    "lint": "eslint --max-warnings 0 src test scripts *.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "npm run test:unit:only",
    "test:unit:only": "node --test --import ./test/unit/support/fastFsync.mjs test/unit/*.test.cjs",
    "test:integration": "npm run compile && node --test test/integration/*.test.cjs",
    "test:integration:only": "node --test test/integration/*.test.cjs",
    "test:windows": "node scripts/test-windows.mjs",
    "test:windows:slow": "node scripts/test-windows.mjs --slow",
    "test:dotnet": "cd backend && dotnet test --project Testy.Backend.Tests",
    "pretest:extension": "npm run compile",
    "test:extension": "node test/extension/run.mjs",
    "test:extension:only": "node test/extension/run.mjs",
    "coverage": "node --test --import ./test/unit/support/fastFsync.mjs --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-exclude=**/node_modules/** --test-coverage-lines=78 --test-coverage-branches=85 --test-coverage-functions=82 test/unit/*.test.cjs",
    "clean": "node scripts/clean.mjs",
    "package": "vsce package --no-dependencies",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:vsix": "node scripts/check-vsix-files.mjs",
    "verify": "node scripts/verify.mjs",
    "benchmark": "npm run compile && node test/performance/benchmark.cjs",
    "benchmark:responsiveness": "npm run compile && node test/performance/responsiveness.cjs",
    "l10n:export": "npx --yes @vscode/l10n-dev@0.0.35 export --outDir ./l10n ./src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "minimatch": "^10.2.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vscode-jsonrpc": "^9.0.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%",
      "restrictedConfigurations": [
        "testy.dotnetPath",
        "testy.coverageToolPath",
        "testy.testArguments",
        "testy.solution",
        "testy.debugConfiguration",
        "testy.buildConfiguration",
        "testy.additionalConfigurations"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtual%"
    }
  }
}
