<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Ordinal comparisons only (hashes, paths, identifiers), so skip loading ICU. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Everything is serialized through source-generated contexts (AnalysisJson), so nothing needs reflection-based System.Text.Json. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Tiered PGO is on by default. The one-shot fallback (a short-lived process) turns it off with DOTNET_TieredPGO=0. -->
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Testy.Backend.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The task runs inside the user's SDK MSBuild. Compile against the oldest
         supported .NET 10 SDK's MSBuild API and never ship a copy of it. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" />
    <!-- Syntax APIs only. Roslyn is loaded at run time from the installed SDK (RoslynLoader). Compile
         against 5.0, the oldest supported (SDK 10.0.100 ships it), and never ship a copy. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
