root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,config}]
indent_style = space
indent_size = 2

# Enforced in the build (EnforceCodeStyleInBuild) and so fatal with TreatWarningsAsErrors. Only rules the
# existing compact style already satisfies are warnings; the rest stay IDE suggestions.
[*.cs]
indent_style = space
indent_size = 4

csharp_style_namespace_declarations = file_scoped
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
csharp_prefer_braces = true
csharp_using_directive_placement = outside_namespace
# Compact style: short blocks and statements may share a line.
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true
csharp_new_line_before_open_brace = all
csharp_new_line_before_members_in_object_initializers = false

# Simplification, pattern matching, unused code and formatting rules that the code satisfies today.
dotnet_diagnostic.IDE0001.severity = warning
dotnet_diagnostic.IDE0002.severity = warning
