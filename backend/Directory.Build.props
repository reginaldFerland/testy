<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A new advisory against a dependency must stay a visible warning, not break packaging. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Line numbers in helper stack traces without shipping separate .pdb files. -->
    <DebugType>embedded</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Pin analyzer rules so a newer SDK cannot add warnings that break packaging. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Roslyn ships localized resources; the extension only needs English. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Keep local source paths out of shipped binaries. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/backend/</PathMap>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TESTY_RELEASE)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- Packaged builds must restore exactly what the lock files record. -->
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
</Project>
