<Project>
  <!-- Evaluated after each project body, so OutputType is known here. -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe' and '$(IsTestProject)' != 'true'">
    <!-- Bundled tools run on whichever .NET 10+ runtime the user has. Test projects (xunit.v3 needs an app host) are not bundled. -->
    <RollForward>Major</RollForward>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>
