{
	// Type-checks every test file against the declarations tsc emits to out/. Run `npm run typecheck:tests` after compiling.
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2024",
		"lib": ["ES2024"],
		"allowJs": true,
		"resolveJsonModule": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noImplicitReturns": true,
		"types": ["node"]
	},
	"include": ["test/**/*.cjs"]
}
